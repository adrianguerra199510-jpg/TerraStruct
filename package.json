{
  "name": "terrastruct",
  "version": "1.0.0",
  "private": true,
  "description": "TerraStruct: análisis y diseño de fundaciones y muros de retención con memoria de cálculo en PDF y Word",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "lucide-react": "^1.62.0",
    "pdfmake": "^0.3.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "author": "TerraStruct",
  "build": {
    "appId": "com.terrastruct.app",
    "productName": "TerraStruct",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/icons/**",
      "package.json"
    ],
    "win": {
      "icon": "public/icons/icon-256.png",
      "target": [
        "zip"
      ]
    },
    "linux": {
      "icon": "public/icons",
      "target": [
        "dir"
      ]
    }
  }
}
